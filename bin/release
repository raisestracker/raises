#!/usr/bin/env bash
# Kamal deploy of the checked-out commit plus production smoke tests.
# Shared by bin/deploy (manual) and the GitHub Actions deploy job.
set -Eeuo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
if [[ -f .kamal/deploy.env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .kamal/deploy.env
  set +a
fi
section() { printf '\n==> %s\n' "$1"; }

: "${KAMAL_BASE_URL:?KAMAL_BASE_URL must be set in .kamal/deploy.env or the environment}"

section "Deploying $(git rev-parse --short HEAD)"
kamal deploy

section "Production smoke tests"
curl --fail --silent --show-error --retry 5 --retry-delay 3 "${KAMAL_BASE_URL%/}/healthz"
printf '\n'
curl --fail --silent --show-error --retry 5 --retry-delay 3 "${KAMAL_BASE_URL%/}/readyz"
printf '\n'

section "Release complete"
