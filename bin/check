#!/usr/bin/env bash
# Pre-deploy checks shared by CI (the job that gates deploys) and bin/deploy.
set -Eeuo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
section() { printf '\n==> %s\n' "$1"; }

section "Tailwind CSS build and dependency audit"
npm ci --ignore-scripts
npm run build:css
npm audit --audit-level=high
# Keep Go module discovery out of generated frontend dependencies.
printf 'module raises.local/frontend\n\ngo 1.18\n' > node_modules/go.mod

section "Go formatting and lint checks"
unformatted="$(git ls-files -z '*.go' | xargs -0 gofmt -l)"
if [[ -n "$unformatted" ]]; then
  printf 'Run gofmt on:\n%s\n' "$unformatted" >&2
  exit 1
fi
go vet ./...

section "Go tests"
go test -race ./...

section "Acceptance suite (Chromium, WebKit, API)"
if [[ "${SKIP_ACCEPTANCE:-0}" == "1" ]]; then
  # The CI acceptance job covers this; lbl-linux has no container runtime.
  printf 'Skipped (SKIP_ACCEPTANCE=1).\n'
else
  # Needs docker or podman, or ACCEPTANCE_NATIVE=1 with local Playwright browsers.
  bin/acceptance
fi

section "Go dependency and vulnerability checks"
go mod verify
go mod tidy -diff
go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...
