#!/usr/bin/env bash

set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
if [[ -f .kamal/deploy.env ]]; then
  # shellcheck disable=SC1091
  set -a
  source .kamal/deploy.env
  set +a
fi
export RUBOCOP_CACHE_ROOT="${RUBOCOP_CACHE_ROOT:-${TMPDIR:-/tmp}/raises-rubocop-cache}"

section() {
  printf '\n==> %s\n' "$1"
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$1" >&2
    exit 1
  fi
}

for command_name in bundle curl git go gofmt kamal npm; do
  require_command "$command_name"
done

if [[ "$(git branch --show-current)" != "master" ]]; then
  printf 'Deploys must run from the master branch.\n' >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'Commit or stash all changes before deploying.\n' >&2
  git status --short >&2
  exit 1
fi

section "Tailwind CSS build and dependency audit"
npm ci --ignore-scripts
npm run build:css
npm audit --audit-level=high
# Keep Go module discovery out of generated frontend dependencies.
printf 'module raises.local/frontend\n\ngo 1.18\n' > node_modules/go.mod

section "Go formatting and lint checks"
unformatted="$(git ls-files -z '*.go' | xargs -0 gofmt -l)"
if [[ -n "$unformatted" ]]; then
  printf 'Run gofmt on:\n%s\n' "$unformatted" >&2
  exit 1
fi
go vet ./...

section "Go tests"
go test -race ./...

section "Go dependency and vulnerability checks"
go mod verify
go mod tidy -diff
go run golang.org/x/vuln/cmd/govulncheck@v1.7.0 ./...

section "Ruby gem tests, lint, and dependency audit"
(
  cd gem
  bundle check
  bundle exec rake test
  bundle exec rubocop
  bundle exec bundler-audit check --update
  gem build raises.gemspec --output /tmp/raises-release-check.gem
)

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'Checks changed the working tree; review before deploying.\n' >&2
  git status --short >&2
  exit 1
fi

section "Synchronizing master"
git fetch origin master
if ! git merge-base --is-ancestor origin/master HEAD; then
  printf 'Local master is missing commits from origin/master. Pull before deploying.\n' >&2
  exit 1
fi
git push origin master

section "Deploying"
kamal deploy

section "Production smoke tests"
if [[ -z "${KAMAL_BASE_URL:-}" ]]; then
  printf 'KAMAL_BASE_URL must be set in .kamal/deploy.env or the environment.\n' >&2
  exit 1
fi
curl --fail --silent --show-error "${KAMAL_BASE_URL%/}/healthz"
printf '\n'
curl --fail --silent --show-error "${KAMAL_BASE_URL%/}/readyz"
printf '\n'

section "Deploy complete"
