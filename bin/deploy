#!/usr/bin/env bash

set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
if [[ -f .kamal/deploy.env ]]; then
  # shellcheck disable=SC1091
  set -a
  source .kamal/deploy.env
  set +a
fi

section() {
  printf '\n==> %s\n' "$1"
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$1" >&2
    exit 1
  fi
}

for command_name in curl gh git go gofmt kamal npm; do
  require_command "$command_name"
done

if [[ "$(git branch --show-current)" != "master" ]]; then
  printf 'Deploys must run from the master branch.\n' >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'Commit or stash all changes before deploying.\n' >&2
  git status --short >&2
  exit 1
fi

bin/check

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'Checks changed the working tree; review before deploying.\n' >&2
  git status --short >&2
  exit 1
fi

section "Synchronizing master"
git fetch origin master
if ! git merge-base --is-ancestor origin/master HEAD; then
  printf 'Local master is missing commits from origin/master. Pull before deploying.\n' >&2
  exit 1
fi
git push origin master

bin/release
bin/release-tag

section "Deploy complete"
