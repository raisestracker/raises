# Public address of this Raises server.
BASE_URL=http://localhost:8080

# Configure every GitHub App value together, or leave all five unset.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=raises
INITIAL_OWNER_GITHUB_ID=0

# Retire legacy static credentials: the AGENT_TOKEN agent credential and all
# APP_*_TOKEN ingestion credentials. Set to exactly 1 only after every client
# has moved to DB-backed agent keys and project ingestion tokens; with 1 the
# old values return 401 on every startup shape, including owner id 0 and
# across restarts. Anything else (including unset) keeps legacy compatibility.
# DISABLE_LEGACY_TOKENS=0

# Optional encryption for outbound webhook endpoints.
# WEBHOOK_ENCRYPTION_KEY=

# Optional Amazon SES reporting and operational alerts. Enable only with all
# three required values.
REPORT_ENABLED=0
OPERATIONAL_ALERTS_ENABLED=0
# REPORT_EMAIL_FROM=
# REPORT_EMAIL_TO=
REPORT_TIMEZONE=UTC
REPORT_SEND_AT=07:00
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Optional ntfy notifications.
NTFY_ENABLED=0
NTFY_BASE_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
