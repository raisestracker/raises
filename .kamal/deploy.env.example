# Copy to .kamal/deploy.env and set your deployment values.
KAMAL_HOST=example.com
KAMAL_SSH_USER=deploy
KAMAL_PROXY_HOST=raises.example.com
KAMAL_BASE_URL=https://raises.example.com
INITIAL_OWNER_GITHUB_ID=0
REPORT_ENABLED=0
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
REPORT_TIMEZONE=UTC
REPORT_SEND_AT=07:00
OPERATIONAL_ALERTS_ENABLED=0
AWS_REGION=
NTFY_ENABLED=0
NTFY_BASE_URL=https://ntfy.sh
